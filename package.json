{
  "name": "reachy_mini_mobile_app",
  "private": true,
  "version": "0.11.0",
  "type": "module",
  "description": "Cross-platform (iOS/Android, desktop-ready) Tauri app that lists the Reachy Minis registered on the Hugging Face central signaling Space and opens the conversation UI",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:dev-screenshot": "tauri dev --config src-tauri/tauri.screenshot.conf.json",
    "tauri:build": "tauri build",
    "ios:dev": "tauri ios dev --open",
    "ios:build": "tauri ios build",
    "android:dev": "tauri android dev --open",
    "android:build": "tauri android build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@choochmeque/tauri-plugin-sharekit-api": "^0.3.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mnlphlp/plugin-blec": "^0.8.0",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "@noble/ciphers": "^1.0.0",
    "@noble/curves": "^1.6.0",
    "@noble/hashes": "^1.5.0",
    "@pollen-robotics/reachy-mini-sdk": "1.10.0-dev.0.main.c8367cd",
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.4.0",
    "@tanstack/react-query": "^5.100.9",
    "@tanstack/react-virtual": "^3.13.24",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-os": "^2.3.2",
    "motion": "^12.38.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tauri-plugin-auth-session-api": "^0.2.2",
    "tauri-plugin-keep-screen-on-api": "^0.1.4",
    "three": "^0.181.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@tauri-apps/cli": "2.11.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.0",
    "@vitejs/plugin-react-swc": "^4.0.0",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.7.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^7.2.1",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^3"
  }
}
