# Build-time environment for the Reachy Mini mobile app.
#
# Vite exposes any variable prefixed with `VITE_` to the client bundle
# via `import.meta.env.VITE_*`. Copy this file to `.env.local` and
# fill in the values you need; `.env.local` is gitignored so secrets
# stay on your machine.
#
# Every variable below is read through the typed funnel in
# `src/shared/env.ts` - `grep ENV. src` shows where each is consumed.
# All have sensible production defaults; uncomment only what you need
# to override.
#
# Voice conversation uses the Hugging Face realtime backend by default.
# No OpenAI key is bundled or required.

# ─── Local development ──────────────────────────────────────────────

# Dev-only Hugging Face token to skip the OAuth sign-in screen in
# `tauri:dev` on desktop (the in-app ASWebAuthenticationSession flow
# only works on iOS / Android, so Linux / Windows can't sign in at all).
# On first boot with no stored token, this value is seeded as if you had
# just signed in. Ignored entirely in production builds (gated behind
# import.meta.env.DEV). Generate one at
# https://huggingface.co/settings/tokens
# VITE_DEV_HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional display name paired with the dev token (cosmetic only).
# VITE_DEV_HF_USERNAME=your-hf-username

# ─── Backend hosts (staging / self-hosted overrides) ────────────────

# HF central signaling Space the fleet registers against.
# Defaults to the production pollen-robotics instance. Override when
# developing against a staging central or a self-hosted relay.
# VITE_REACHY_CENTRAL_URL=https://pollen-robotics-reachy-mini-central.hf.space

# Reachy Mini backend API host. Serves `/api/js-apps` (app catalog and
# user app metadata). The env var name stays `VITE_REACHY_WEBSITE_URL`
# for backward compatibility.
# VITE_REACHY_WEBSITE_URL=https://pollen-robotics-reachy-mini-api.hf.space

# Reachy Sticker Generator Space (custom-personality avatars).
# VITE_REACHY_STICKER_URL=https://pollen-robotics-reachy-sticker-generator.hf.space

# ─── HF realtime backend (local / LAN speech-to-speech dev) ─────────

# Connection mode. `deployed` uses the app-managed HF session
# allocator. `local` connects directly to VITE_HF_REALTIME_WS_URL.
# VITE_HF_REALTIME_CONNECTION_MODE=deployed

# App-managed HF realtime session allocator (used in `deployed` mode).
# VITE_HF_REALTIME_SESSION_PROXY_URL=https://pollen-robotics-reachy-mini-realtime-url.hf.space/session

# Direct local/LAN HF realtime endpoint (used only in `local` mode).
# Accepts ws://127.0.0.1:8765/v1 or ws://127.0.0.1:8765/v1/realtime.
# VITE_HF_REALTIME_WS_URL=ws://127.0.0.1:8765/v1/realtime

# ─── HF model & routing overrides (advanced / A-B testing) ──────────

# Text model that authors custom personalities. Append `:<provider>` /
# `:fastest` / `:cheapest` to pin a routing policy.
# VITE_PERSONALITY_HF_MODEL=Qwen/Qwen2.5-72B-Instruct

# Text model that turns a persona into a visual theme for the sticker
# generator (small + widely served).
# VITE_REACHY_STICKER_THEME_MODEL=Qwen/Qwen2.5-7B-Instruct

# Vision-language model used to describe what the robot sees. Append
# `:fastest` / `:cheapest` / `:<provider>` to pin a routing policy.
# Default is a non-reasoning VLM (reasoning models can return empty
# content). Override examples: Qwen/Qwen2.5-VL-72B-Instruct, zai-org/GLM-4.5V
# VITE_VISION_HF_MODEL=google/gemma-3-27b-it

# Default HF router policy suffix. One of: auto | fastest | cheapest |
# preferred. `preferred` honours the user's HF Inference Provider order.
# VITE_HF_ROUTER_POLICY=preferred

# Router model fallback chain (comma-separated ids, tried large -> small
# when the preferred model is overloaded or unsupported).
# VITE_HF_MODEL_CHAIN=meta-llama/Llama-3.3-70B-Instruct,Qwen/Qwen2.5-72B-Instruct,meta-llama/Llama-3.1-8B-Instruct,Qwen/Qwen2.5-7B-Instruct,mistralai/Mistral-7B-Instruct-v0.3
