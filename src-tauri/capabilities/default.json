{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimum capabilities for the Reachy Mini mobile client: OS detection + daemon fetch + mDNS discovery events.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "os:allow-platform",
    "os:allow-version",
    "os:allow-os-type",
    "auth-session:default",
    "keep-screen-on:default",
    "blec:default",
    "blec:allow-check-permissions",
    "sharekit:allow-share-file",
    "fs:allow-appcache-write-recursive",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://huggingface.co/*" },
        { "url": "https://*.hf.space/*" },
        { "url": "https://*.huggingface.co/*" },
        { "url": "http://reachy-mini.local:8000/*" },
        { "url": "http://192.168.*:8000/*" },
        { "url": "http://10.*:8000/*" },
        { "url": "http://172.*:8000/*" }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://router.huggingface.co/*" },
        { "url": "https://*.hf.space/*" }
      ]
    }
  ]
}
