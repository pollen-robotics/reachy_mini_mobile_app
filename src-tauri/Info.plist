<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        Required for `btleplug` to call `CBCentralManager`. If this key is
        missing, macOS silently denies the very first scan attempt and
        every subsequent call fails with "Channel closed".
    -->
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>Reachy Mini uses Bluetooth to discover your robot and read its network status (IP address, WiFi mode).</string>

    <!--
        Used on iOS 12 and earlier. Harmless on modern macOS / iOS but
        recommended for App Store submissions to avoid reviewer questions.
    -->
    <key>NSBluetoothPeripheralUsageDescription</key>
    <string>Reachy Mini uses Bluetooth to discover your robot and read its network status.</string>

    <!--
        The app talks to the daemon over plain HTTP on the local network
        (daemon:8000). Without this the WebView would silently block
        `daemon_fetch` despite the request going through the Rust side.
    -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>

    <!--
        Required on macOS Sonoma+ and iOS 14+ to advertise our intent to
        use local network services (Bonjour, LAN HTTP, etc.).
    -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>Reachy Mini needs local network access to talk to the robot daemon on port 8000.</string>

    <!--
        Required for the native conversation (OpenAI Realtime over WebRTC)
        and for embedded Spaces like `cduss/webrtc_example` that capture
        audio from the phone. Without it the webview returns
        NotAllowedError when calling getUserMedia.
    -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Reachy Mini needs microphone access to let you talk to the robot through voice conversations.</string>

    <!--
        Lock the iPhone build to portrait. The whole layout is built
        around a 420px-wide content column, a top bar that respects
        `safe-area-inset-top`, and a BottomNavigation that respects
        `safe-area-inset-bottom`. Landscape would expose the notch on
        the side of the screen (where we don't read
        `safe-area-inset-left/right`) and squeeze the orb into a wide
        flat band that breaks the conversation visual.

        Three keys to set, on purpose:
          - `UISupportedInterfaceOrientations` covers the iPhone case
            (iOS uses the iPhone array on phones).
          - `UISupportedInterfaceOrientations~ipad` covers the iPad
            case (iOS reads the suffixed key on iPads). We allow both
            portraits but not landscape on iPad either; the layout
            assumes a tall column.
          - `UIRequiresFullScreen` (true) prevents iPad multitasking /
            Slide Over / Split View, which would resize the WebView
            mid-session and re-trigger the WebRTC `RTCPeerConnection`
            into a pile of `iceconnectionstatechange = checking` for
            no good reason.
    -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
    </array>
    <key>UIRequiresFullScreen</key>
    <true/>

    <!--
        Status-bar styling is delegated to each view controller (true)
        so a future call to `setNeedsStatusBarAppearanceUpdate()` from
        a Tauri command can swap dark/light tint to follow our
        in-app dark-mode toggle. With the default `false`, the system
        uses the Info.plist `UIStatusBarStyle` once at launch and
        never updates after that.

        `UIStatusBarStyle = Default` lets iOS pick automatically
        between dark and light text based on the user's system
        appearance, which lines up with our `prefers-color-scheme`
        theme switching.
    -->
    <key>UIViewControllerBasedStatusBarAppearance</key>
    <true/>
    <key>UIStatusBarStyle</key>
    <string>UIStatusBarStyleDefault</string>
</dict>
</plist>
