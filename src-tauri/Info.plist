<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        The app talks to the daemon over plain HTTP on the local network
        (daemon:8000). Without this the WebView would silently block
        `daemon_fetch` despite the request going through the Rust side.
    -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>

    <!--
        Required on macOS Sonoma+ and iOS 14+ to advertise our intent to
        use local network services (Bonjour, LAN HTTP, etc.).
    -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>Reachy Mini needs local network access to talk to the robot daemon on port 8000.</string>

    <!--
        Microphone. Required for the WebRTC handshake of the voice
        conversation feature:
          - iOS WKWebView withholds LAN host ICE candidates until
            any media permission has been granted, so the phone's
            `RTCPeerConnection` can't find the robot on the local
            network without the mic grant
            (see `features/conversation/permissions/iosMicUnlock.ts`).
          - The vendored SDK opens a `getUserMedia({audio:true})`
            during `startSession()`; that capture is swapped for
            OpenAI's output track and immediately released, so no
            phone audio is recorded or transmitted.
        The user's voice itself is captured by the robot's onboard
        microphone, NOT by the phone.
    -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Reachy Mini briefly opens the microphone on this device to establish a WebRTC connection with the robot. Your voice is captured by Reachy Mini\u2019s own microphone, not this device; no phone audio is recorded or transmitted.</string>

    <!--
        Camera and location keys were here historically to authorise
        iframe-hosted HF Spaces (vision demos, AR scenes, geolocation
        Spaces) to surface their own `navigator.*` prompts. With the
        Apps tab hidden behind `APPS_TAB_ENABLED = false` (see
        `src/ui/screens/RobotSessionScreen.tsx`), no iframe is ever
        mounted, so both keys were removed for the first App Store
        submission - keeping orphan `NSXxxUsageDescription` strings
        without a corresponding feature is flagged by App Review as
        "permission requested without a functional reason".
        Re-add them in lockstep when `APPS_TAB_ENABLED` flips back
        to `true`; the previous string contents are in git history.
    -->

    <!--
        Lock the build to portrait. The whole layout is built around
        a 420px-wide content column, a top bar that respects
        `safe-area-inset-top`, and a BottomNavigation that respects
        `safe-area-inset-bottom`. Landscape would expose the notch on
        the side of the screen (where we don't read
        `safe-area-inset-left/right`) and squeeze the orb into a wide
        flat band that breaks the conversation visual.

        The iPad variant (`UISupportedInterfaceOrientations~ipad`)
        used to live here but was removed when we switched the build
        to iPhone-only (`TARGETED_DEVICE_FAMILY = "1"`, patched in
        `.github/workflows/build-mobile.yml`). With no iPad slice in
        the IPA the suffixed key is dead weight.
    -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>

    <!--
        Status-bar styling is delegated to each view controller (true)
        so a future call to `setNeedsStatusBarAppearanceUpdate()` from
        a Tauri command can swap dark/light tint to follow our
        in-app dark-mode toggle. With the default `false`, the system
        uses the Info.plist `UIStatusBarStyle` once at launch and
        never updates after that.

        `UIStatusBarStyle = Default` lets iOS pick automatically
        between dark and light text based on the user's system
        appearance, which lines up with our `prefers-color-scheme`
        theme switching.
    -->
    <key>UIViewControllerBasedStatusBarAppearance</key>
    <true/>
    <key>UIStatusBarStyle</key>
    <string>UIStatusBarStyleDefault</string>

    <!--
        Background-audio capability for the OpenAI Realtime
        conversation pipeline. Without `audio` in
        `UIBackgroundModes`, iOS suspends the WKWebView process a
        few seconds after the user locks the screen or switches
        apps, killing the WebRTC peer connection AND the JS
        runtime. With it (combined with the runtime keepalive in
        `src/features/conversation/background-audio-keeper.ts` that
        keeps a non-zero AudioContext output alive while a conv is
        running), iOS keeps us scheduled and the user can put the
        phone in their pocket / lock the screen / look at another
        app and the conversation keeps going.

        App Store rationale: this is a voice-conversation app, the
        "audio" background mode matches actual audio playback +
        recording behaviour. Mirrors the entitlement set used by
        Siri, Discord, Slack call panels, Google Assistant, etc.
    -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>
</dict>
</plist>
