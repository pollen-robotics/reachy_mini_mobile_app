node_modules
dist
dist-ssr
.DS_Store
*.local
.env
.env.local

# Tauri
src-tauri/target
src-tauri/gen/schemas

# CocoaPods (iOS) - regenerated locally by `pod install` after
# `tauri ios init`. Podfile.lock IS committed alongside Podfile so
# everyone resolves to the same pod versions, but the Pods/ tree
# itself and the xcworkspace generated by CocoaPods are local-only.
src-tauri/gen/apple/Pods/
src-tauri/gen/apple/*.xcworkspace/

# IDE
.vscode/*
!.vscode/extensions.json
.idea

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
